{%- comment -%}
  The oversized wordmark that closes every page. The device is common in premium DTC;
  the execution is ours — Newsreader at optical size, cropped at the baseline so the
  letterforms run off the page rather than sitting in a box.
{%- endcomment -%}
<section class="safaa-wordmark">
  <div class="safaa-wordmark__links">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights }}</p>
    <nav aria-label="Legal">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>
  {%- comment -%}
    Decorative: the mark is the shop name again, so hide it from assistive tech. Only this
    div — an aria-hidden ancestor would swallow the legal links, which must stay reachable.
  {%- endcomment -%}
  <div class="safaa-wordmark__mark" aria-hidden="true">
    <span>{{ section.settings.word | default: shop.name }}</span>
  </div>
</section>

{% schema %}
{
  "name": "SAFAA wordmark",
  "settings": [
    { "type": "text", "id": "word", "label": "Wordmark", "default": "SAFAA" },
    { "type": "text", "id": "rights", "label": "Rights line", "default": "All rights reserved." },
    { "type": "link_list", "id": "menu", "label": "Legal menu", "default": "footer" }
  ],
  "presets": [{ "name": "SAFAA wordmark" }]
}
{% endschema %}
